import { Button, CheckBox, ComboBox, LineEdit, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component CaptionWindow inherits Window {
    title: "Gemini Live Translator · 字幕";
    width: 760px;
    height: 138px;
    background: #101820e8;
    in-out property <string> original-text: "等待语音输入…";
    in-out property <string> translated-text: "翻译将在这里显示";
    in-out property <float> caption-scale: 1.0;
    in-out property <bool> transcription-only: false;

    VerticalBox {
        padding: 15px;
        spacing: 7px;
        Text { text: root.original-text; color: #e8eef2; font-size: 16px * root.caption-scale; overflow: elide; }
        Text {
            visible: !root.transcription-only;
            text: root.translated-text;
            color: #87e8c7;
            font-size: 20px * root.caption-scale;
            font-weight: 700;
            overflow: elide;
        }
    }
}

export component ControlWindow inherits Window {
    title: "Gemini Live Translator · Slint 迁移预览";
    width: 620px;
    height: 900px;
    background: #f5f7f8;

    in-out property <string> api-key: "";
    in-out property <bool> save-sensitive: false;
    in-out property <bool> vault-exists: false;
    in-out property <string> vault-password: "";
    in-out property <int> model-index: 0;
    in-out property <int> target-index: 0;
    in-out property <int> thinking-index: 0;
    in-out property <int> transcription-index: 0;
    in-out property <int> source-index: 0;
    in-out property <[string]> microphone-model: ["系统默认麦克风"];
    in-out property <[string]> system-model: ["系统默认音频源"];
    in-out property <[string]> playback-model: ["系统默认播放设备"];
    in-out property <int> microphone-index: 0;
    in-out property <int> system-index: 0;
    in-out property <int> playback-index: 0;
    in-out property <string> microphone-device-id: "";
    in-out property <string> system-device-id: "";
    in-out property <string> playback-device-id: "";
    in-out property <int> proxy-index: 0;
    in-out property <string> proxy-url: "";
    in-out property <bool> bidirectional: false;
    in-out property <bool> token-saver: true;
    in-out property <bool> playback-enabled: false;
    in-out property <bool> overlay-locked: true;
    in-out property <float> overlay-scale: 1.0;
    in-out property <bool> session-running: false;
    in-out property <bool> probe-running: false;
    in-out property <string> status-message: "Slint 桌面迁移预览 · 尚未连接会话后端";

    callback start-stop();
    callback probe-transport();
    callback save-settings();
    callback unlock-vault();
    callback remove-vault();
    callback refresh-devices();
    callback toggle-overlay-lock();
    callback overlay-scale-changed(float);
    callback quit-requested();

    VerticalBox {
        padding: 24px;
        spacing: 13px;

        Text { text: "LIVE / TRANSLATOR"; color: #0b6b57; font-size: 14px; font-weight: 700; }
        Text { text: "实时语音翻译与转写."; color: #14242c; font-size: 28px; font-weight: 700; }
        Rectangle { height: 1px; background: #d7dfe2; }

        Text { text: "01 连接配置"; color: #14242c; font-size: 17px; font-weight: 700; }
        Text { text: "Gemini API Key"; color: #44545b; }
        LineEdit { text <=> root.api-key; input-type: password; placeholder-text: "输入 API Key（不会进入普通设置或日志）"; }
        CheckBox { text: "使用密码加密保存 API Key 和手动代理"; checked <=> root.save-sensitive; }
        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text <=> root.vault-password;
                input-type: password;
                placeholder-text: root.vault-exists ? "输入密码解锁或更新保险库" : "设置至少 8 字符的保险库密码";
            }
            Button { text: root.vault-exists ? "解锁" : "创建"; clicked => { root.unlock-vault(); } }
            Button { enabled: root.vault-exists; text: "删除"; clicked => { root.remove-vault(); } }
            Button { text: "保存设置"; clicked => { root.save-settings(); } }
        }
        HorizontalBox {
            spacing: 10px;
            ComboBox {
                enabled: !root.session-running;
                current-index <=> root.model-index;
                model: ["Gemini 3.8 Live", "3.8 Extended Thinking", "3.5 Live Translate", "3.5 Transcribe Live"];
            }
            ComboBox {
                enabled: !root.session-running;
                current-index <=> root.target-index;
                model: ["中文", "English", "日本語", "한국어", "Español", "Français", "Deutsch", "Italiano"];
            }
        }
        HorizontalBox {
            spacing: 10px;
            ComboBox {
                enabled: root.model-index == 1 && !root.session-running;
                current-index <=> root.thinking-index;
                model: ["思考等级：低", "思考等级：中", "思考等级：高"];
            }
            ComboBox {
                enabled: root.model-index == 3 && !root.session-running;
                current-index <=> root.transcription-index;
                model: ["逐字转写", "智能整理"];
            }
        }
        CheckBox { enabled: root.model-index <= 1 && !root.session-running; text: "双向自动切换"; checked <=> root.bidirectional; }
        HorizontalBox {
            spacing: 10px;
            ComboBox { current-index <=> root.proxy-index; model: ["自动代理 / VPN", "手动代理", "系统网络直连"]; }
            LineEdit { enabled: root.proxy-index == 1; text <=> root.proxy-url; placeholder-text: "http://127.0.0.1:7890"; }
        }

        Rectangle { height: 1px; background: #d7dfe2; }
        Text { text: "02 音频与设备"; color: #14242c; font-size: 17px; font-weight: 700; }
        HorizontalBox {
            spacing: 10px;
            ComboBox { enabled: !root.session-running; current-index <=> root.source-index; model: ["麦克风", "系统音频", "混合音源"]; }
            Button { enabled: !root.session-running; text: "刷新设备"; clicked => { root.refresh-devices(); } }
        }
        HorizontalBox {
            spacing: 8px;
            ComboBox { enabled: !root.session-running && root.source-index != 1; current-index <=> root.microphone-index; model: root.microphone-model; }
            ComboBox { enabled: !root.session-running && root.source-index != 0; current-index <=> root.system-index; model: root.system-model; }
            ComboBox { enabled: !root.session-running && root.playback-enabled && root.model-index != 3; current-index <=> root.playback-index; model: root.playback-model; }
        }
        HorizontalBox {
            spacing: 20px;
            CheckBox { enabled: !root.session-running; text: "静音时节省 Token"; checked <=> root.token-saver; }
            CheckBox { text: "播放翻译语音"; checked <=> root.playback-enabled; enabled: !root.session-running && root.model-index != 3; }
        }

        Rectangle { height: 1px; background: #d7dfe2; }
        Text { text: "03 字幕窗口"; color: #14242c; font-size: 17px; font-weight: 700; }
        HorizontalBox {
            spacing: 12px;
            Button { text: root.overlay-locked ? "解锁字幕窗" : "锁定字幕窗"; clicked => { root.toggle-overlay-lock(); } }
            Text { text: "缩放 " + round(root.overlay-scale * 100) + "%"; vertical-alignment: center; color: #44545b; }
            Slider { minimum: 0.8; maximum: 1.6; value <=> root.overlay-scale; changed(value) => { root.overlay-scale-changed(value); } }
        }

        Rectangle { height: 1px; background: #d7dfe2; }
        Rectangle {
            height: 66px;
            border-radius: 8px;
            background: root.session-running ? #dff7ee : #e9eef0;
            Text {
                x: 14px; width: parent.width - 28px; height: parent.height;
                text: root.status-message; color: #24434a; vertical-alignment: center; wrap: word-wrap;
            }
        }
        HorizontalBox {
            spacing: 12px;
            Button { text: "退出"; clicked => { root.quit-requested(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { enabled: !root.session-running; text: root.probe-running ? "取消网络测试" : "测试网络"; clicked => { root.probe-transport(); } }
            Button { enabled: !root.probe-running; text: root.session-running ? "停止" : "验证并开始"; primary: true; clicked => { root.start-stop(); } }
        }
        Text {
            text: "v1.1.0 migration build · Rust 1.100 · Slint 1.18.1";
            color: #718087;
            horizontal-alignment: center;
            font-size: 11px;
        }
    }
}
