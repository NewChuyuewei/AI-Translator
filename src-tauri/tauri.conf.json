{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gemini Live Translator",
  "version": "0.1.6",
  "identifier": "com.gemini.live.translator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "实时字幕", "url": "index.html", "width": 760, "height": 138,
        "minWidth": 360, "minHeight": 110, "resizable": true, "transparent": true, "shadow": false,
        "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "focus": false,
        "visibleOnAllWorkspaces": true },
      { "label": "control", "title": "Gemini Live Translator · 控制面板", "url": "control.html",
        "width": 590, "height": 810, "minWidth": 380, "minHeight": 560, "resizable": true, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 chuyuewei. All rights reserved.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": { "minSdkVersion": 26 },
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": "Entitlements.plist" },
    "shortDescription": "Gemini Live 实时同声传译"
  }
}
